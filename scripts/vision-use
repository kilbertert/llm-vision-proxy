#!/usr/bin/env python3
"""vision-use - point Claude Code at the llm-vision-proxy and select a backend model.

Non-invasive: rewrites only the `env` block of ~/.claude/settings.json, preserving
all other keys. The original (pre-vision) settings are snapshotted once to
settings.json.pre-vision and can be restored with `vision-use off`.

Usage:
    vision-use                # list available models from config.yaml
    vision-use <model>        # route Claude Code through the proxy using <model>
    vision-use off            # restore the original (pre-vision) settings

Note: `cc-switch use <id>` overwrites settings.json and bypasses the proxy for that
session; re-run `vision-use <model>` to re-enable vision.
"""

from __future__ import annotations

import json
import re
import shutil
import sys
from pathlib import Path

CONFIG = Path(__file__).resolve().parent.parent / "config.yaml"
SETTINGS = Path.home() / ".claude" / "settings.json"
PRE_VISION = SETTINGS.with_name("settings.json.pre-vision")
PROXY_URL = "http://127.0.0.1:8417"
DUMMY_TOKEN = "vision-proxy"


def list_models(config: Path) -> list[str]:
    models: list[str] = []
    in_upstreams = False
    for line in config.read_text(encoding="utf-8").splitlines():
        if line.rstrip() == "upstreams:":
            in_upstreams = True
            continue
        if in_upstreams:
            if line and not line.startswith(" ") and not line.startswith("#"):
                in_upstreams = False
                continue
            m = re.match(r"^  ([A-Za-z0-9_.\-]+):\s*$", line)
            if m:
                models.append(m.group(1))
    return models


def read_settings() -> dict:
    if SETTINGS.exists():
        return json.loads(SETTINGS.read_text(encoding="utf-8"))
    return {}


def write_settings(data: dict) -> None:
    SETTINGS.parent.mkdir(parents=True, exist_ok=True)
    SETTINGS.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")


def snapshot_original() -> None:
    """One-time snapshot of the pre-vision settings so `off` can fully restore."""
    if not PRE_VISION.exists() and SETTINGS.exists():
        shutil.copy2(SETTINGS, PRE_VISION)


def set_model(model: str) -> None:
    models = list_models(CONFIG)
    if not models:
        sys.exit(f"no upstreams found in {CONFIG}")
    if model not in models:
        sys.exit(f"model '{model}' not in config upstreams: {', '.join(models)}")
    snapshot_original()
    data = read_settings()
    env = data.setdefault("env", {})
    env["ANTHROPIC_BASE_URL"] = PROXY_URL
    env["ANTHROPIC_AUTH_TOKEN"] = DUMMY_TOKEN
    env["ANTHROPIC_DEFAULT_OPUS_MODEL"] = model
    env["ANTHROPIC_DEFAULT_SONNET_MODEL"] = model
    env["ANTHROPIC_DEFAULT_HAIKU_MODEL"] = model
    write_settings(data)
    print(f"vision proxy ON -> {PROXY_URL} (model={model})")
    print(f"snapshot saved: {PRE_VISION}  (restore with: vision-use off)")


def turn_off() -> None:
    if PRE_VISION.exists():
        shutil.copy2(PRE_VISION, SETTINGS)
        print(f"vision proxy OFF -> restored {SETTINGS} from {PRE_VISION}")
    else:
        # No snapshot: just drop the proxy env keys we manage.
        data = read_settings()
        env = data.get("env", {})
        for k in (
            "ANTHROPIC_BASE_URL",
            "ANTHROPIC_AUTH_TOKEN",
            "ANTHROPIC_DEFAULT_OPUS_MODEL",
            "ANTHROPIC_DEFAULT_SONNET_MODEL",
            "ANTHROPIC_DEFAULT_HAIKU_MODEL",
        ):
            env.pop(k, None)
        write_settings(data)
        print("vision proxy OFF -> removed proxy env keys (no snapshot found)")


def main() -> None:
    if not CONFIG.exists():
        sys.exit(f"config not found: {CONFIG}")
    args = sys.argv[1:]
    if not args:
        models = list_models(CONFIG)
        print(f"Available models ({CONFIG}):")
        for m in models:
            print(f"  - {m}")
        print("\nusage: vision-use <model>   |   vision-use off")
        return
    if args[0] in ("-h", "--help"):
        print(__doc__)
        return
    if args[0] == "off":
        turn_off()
        return
    set_model(args[0])


if __name__ == "__main__":
    main()

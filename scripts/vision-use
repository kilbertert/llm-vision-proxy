#!/usr/bin/env python3
"""vision-use - point Claude Code at the vision shim and select a backend model.

The vision shim (visionproxy, 8417) forwards to cliproxyapi (8317), which owns all
model routing. So the available models are cliproxyapi's catalog. This helper lists
them (queried from cliproxyapi /v1/models) and rewrites only the `env` block of
~/.claude/settings.json, preserving all other keys.

Usage:
    vision-use                # list available models from cliproxyapi
    vision-use <model>        # route Claude Code through the shim using <model>
    vision-use off            # restore the original (pre-vision) settings
"""

from __future__ import annotations

import json
import re
import shutil
import sys
import urllib.request
from pathlib import Path

import yaml

PROXY_URL = "http://127.0.0.1:8417"
DUMMY_TOKEN = "vision-proxy"
CONFIG = Path(__file__).resolve().parent.parent / "config.yaml"
SETTINGS = Path.home() / ".claude" / "settings.json"
PRE_VISION = SETTINGS.with_name("settings.json.pre-vision")


def _forward() -> tuple[str, str]:
    cfg = yaml.safe_load(CONFIG.read_text(encoding="utf-8"))
    fwd = cfg["forward"]
    return fwd["url"].rstrip("/"), fwd["api_key"]


def list_models() -> list[str]:
    url, key = _forward()
    req = urllib.request.Request(url + "/v1/models", headers={"Authorization": f"Bearer {key}"})
    try:
        with urllib.request.urlopen(req, timeout=10) as r:
            data = json.loads(r.read().decode())
        return [m.get("id") for m in data.get("data", []) if m.get("id")]
    except Exception as exc:
        print(f"(could not query cliproxyapi /v1/models: {exc})", file=sys.stderr)
        return []


def read_settings() -> dict:
    return json.loads(SETTINGS.read_text(encoding="utf-8")) if SETTINGS.exists() else {}


def write_settings(data: dict) -> None:
    SETTINGS.parent.mkdir(parents=True, exist_ok=True)
    SETTINGS.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")


def snapshot_original() -> None:
    if not PRE_VISION.exists() and SETTINGS.exists():
        shutil.copy2(SETTINGS, PRE_VISION)


def set_model(model: str) -> None:
    snapshot_original()
    data = read_settings()
    env = data.setdefault("env", {})
    env["ANTHROPIC_BASE_URL"] = PROXY_URL
    env["ANTHROPIC_AUTH_TOKEN"] = DUMMY_TOKEN
    env["ANTHROPIC_DEFAULT_OPUS_MODEL"] = model
    env["ANTHROPIC_DEFAULT_SONNET_MODEL"] = model
    env["ANTHROPIC_DEFAULT_HAIKU_MODEL"] = model
    write_settings(data)
    print(f"vision shim ON -> {PROXY_URL} (model={model})")
    print(f"snapshot saved: {PRE_VISION}  (restore with: vision-use off)")


def turn_off() -> None:
    if PRE_VISION.exists():
        shutil.copy2(PRE_VISION, SETTINGS)
        print(f"vision shim OFF -> restored {SETTINGS} from {PRE_VISION}")
    else:
        data = read_settings()
        for k in (
            "ANTHROPIC_BASE_URL", "ANTHROPIC_AUTH_TOKEN",
            "ANTHROPIC_DEFAULT_OPUS_MODEL", "ANTHROPIC_DEFAULT_SONNET_MODEL",
            "ANTHROPIC_DEFAULT_HAIKU_MODEL",
        ):
            data.get("env", {}).pop(k, None)
        write_settings(data)
        print("vision shim OFF -> removed proxy env keys (no snapshot found)")


def main() -> None:
    if not CONFIG.exists():
        sys.exit(f"config not found: {CONFIG}")
    args = sys.argv[1:]
    if not args:
        models = list_models()
        print(f"Available models (cliproxyapi catalog, {len(models)}):")
        for m in models:
            print(f"  - {m}")
        print("\nusage: vision-use <model>   |   vision-use off")
        return
    if args[0] in ("-h", "--help"):
        print(__doc__)
        return
    if args[0] == "off":
        turn_off()
        return
    set_model(args[0])


if __name__ == "__main__":
    main()
